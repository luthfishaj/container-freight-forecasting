# Template for secrets. Copy this file to .env and replace the
# placeholder values. The .env file is git-ignored and must never be
# committed.

# FRED API key (free registration). Only needed if FRED series are
# downloaded through the API rather than the public CSV export.
FRED_API_KEY=your_fred_api_key_here

# Google Cloud settings. Optional, used only if the warehouse is
# mirrored to BigQuery in Phase 11 (requires the owner's approval).
# GCP_PROJECT_ID=your_gcp_project_id_here
# GOOGLE_APPLICATION_CREDENTIALS=path/to/service_account_key.json
