# Data: regenerated by the ingestion scripts. Only the folder
# placeholders and the download manifest are tracked. Manually
# downloaded index files stay local because their licences may not
# allow redistribution.
data/raw/*
!data/raw/.gitkeep
!data/raw/manifest.csv
!data/raw/manual/
data/raw/manual/*
!data/raw/manual/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Local SQL warehouse (rebuilt from the data folders)
warehouse/*
!warehouse/.gitkeep

# Experiment tracking (MLflow local file store)
mlruns/
mlartifacts/
